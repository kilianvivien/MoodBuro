{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Only the bundled local UI can invoke application commands. Remote views and auth windows have no grants.",
  "local": true,
  "webviews": [
    "shell"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-assistant-status",
    "allow-assistant-configure",
    "allow-assistant-key-set",
    "allow-assistant-key-remove",
    "allow-assistant-models",
    "allow-assistant-panel",
    "allow-assistant-history",
    "allow-assistant-send",
    "allow-assistant-cancel",
    "allow-assistant-confirm",
    "allow-assistant-open-file",
    "allow-assistant-current-course",
    "allow-reminders-picks",
    "allow-reminders-pick",
    "allow-assistant-clear",
    "allow-offline-resources",
    "allow-offline-saved",
    "allow-offline-save",
    "allow-offline-open",
    "allow-offline-remove",
    "allow-course-sync-list",
    "allow-course-sync-configure",
    "allow-course-sync-control",
    "allow-sites-list",
    "allow-site-move",
    "allow-agenda-export",
    "allow-calendar-handoffs",
    "allow-calendar-subscribe",
    "allow-site-add",
    "allow-site-switch",
    "allow-show-onboarding",
    "allow-nav",
    "allow-site-reauthenticate",
    "allow-site-remove",
    "allow-shell-view",
    "allow-session-status",
    "allow-bookmarks-list",
    "allow-bookmark-menu",
    "allow-bookmark-capture",
    "allow-bookmark-save",
    "allow-bookmark-delete",
    "allow-bookmark-open",

    "allow-settings-get",
    "allow-settings-set",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-site-label-set",
    "allow-unread-list",
    "allow-deep-link-open",
    "allow-downloads-page",
    "allow-downloads-clear",
    "allow-download-copy-path",
    "allow-inbox-list",
    "allow-inbox-mark-read",
    "allow-site-open-page",
    "allow-courses-list",
    "allow-activities-list",
    "allow-courses-refresh",
    "allow-course-pin",
    "allow-agenda-list",
    "allow-reminders-list",
    "allow-reminders-set",
    "allow-agenda-refresh",
    "allow-download-preview",
    "allow-course-folders-refresh",
    "allow-download-open",
    "allow-download-reveal"
  ]
}
